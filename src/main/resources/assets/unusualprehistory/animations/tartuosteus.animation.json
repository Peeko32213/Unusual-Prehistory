{
	"format_version": "1.8.0",
	"animations": {
		"animation.tartuosteus.flip_blend1": {
			"loop": "hold_on_last_frame",
			"animation_length": 2,
			"bones": {
				"body_overlay": {
					"rotation": {
						"0.0": [0, 0, "math.sin(query.anim_time*180/4)*360"],
						"1.6667": [0, 0, 360],
						"1.9583": [0, 0, 360],
						"2.0": {"pre": [0, 0, 360], "post": [0, 0, 0]}
					}
				}
			}
		},
		"animation.tartuosteus.flip_blend2": {
			"loop": "hold_on_last_frame",
			"animation_length": 2,
			"bones": {
				"body_overlay": {
					"rotation": {
						"0.0": [0, 0, "math.sin(query.anim_time*180/2.5)*360"],
						"1.6667": [0, 0, -350],
						"1.8333": [0, 0, -365],
						"1.9583": [0, 0, -360],
						"2.0": {"pre": [0, 0, -360], "post": [0, 0, 0]}
					}
				}
			}
		},
		"animation.tartuosteus.idle": {
			"loop": true,
			"animation_length": 8,
			"bones": {
				"body": {
					"rotation": ["math.sin(query.anim_time*45-30)*-7.5", "math.sin(query.anim_time*180)*7.5", "math.sin(query.anim_time*180+90)*-5"],
					"position": ["math.sin(query.anim_time*180-90)*-1", "3+math.sin(query.anim_time*45+60)*-3", 0]
				},
				"tail": {
					"rotation": ["math.sin(query.anim_time*45+60)*7.5", "math.sin(query.anim_time*180+90)*-15", "math.sin(query.anim_time*180)*-5"]
				},
				"left_fin": {
					"rotation": [0, 0, "math.sin(query.anim_time*180*3)*5+math.sin(query.anim_time*45-60)*20"]
				},
				"right_fin": {
					"rotation": [0, 0, "math.sin(query.anim_time*180*3)*-5+math.sin(query.anim_time*45-60)*-20"]
				}
			}
		},
		"animation.tartuosteus.rest": {
			"loop": true,
			"animation_length": 8,
			"bones": {
				"body": {
					"rotation": ["10+math.sin(query.anim_time*45-30)*-5", "math.sin(query.anim_time*180)*7.5", "math.sin(query.anim_time*180+90)*-2.5"],
					"position": ["math.sin(query.anim_time*180-90)*-0.5", 0, 0]
				},
				"tail": {
					"rotation": ["math.sin(query.anim_time*45+60)*10", "math.sin(query.anim_time*180+90)*-10", "math.sin(query.anim_time*180)*-5"]
				},
				"left_fin": {
					"rotation": [0, 0, "math.sin(query.anim_time*180*3)*5"]
				},
				"right_fin": {
					"rotation": [0, 0, "math.sin(query.anim_time*180*3)*-5"]
				}
			}
		},
		"animation.tartuosteus.swim": {
			"loop": true,
			"animation_length": 8,
			"bones": {
				"body": {
					"rotation": ["math.sin(query.anim_time*90-30)*(-5+5*query.is_on_ground)", "math.sin(query.anim_time*720)*7.5", "math.sin(query.anim_time*720+60)*-2.5"],
					"position": ["math.sin(query.anim_time*720-135)*-1", "1-1*query.is_on_ground+math.sin(query.anim_time*90+60)*(-1+1*query.is_on_ground)", 0]
				},
				"tail": {
					"rotation": [
						"math.sin(query.anim_time*90+30)*(7.5-5*query.is_on_ground)",
						"math.sin(query.anim_time*720+90)*-20",
						"math.sin(query.anim_time*720-90)*-5"
					]
				},
				"left_fin": {
					"rotation": [0, 0, "-10+math.sin(query.anim_time*360*3)*5+math.sin(query.anim_time*90-60)*(15-10*query.is_on_ground)"]
				},
				"right_fin": {
					"rotation": [0, 0, "10+math.sin(query.anim_time*360*3)*-5+math.sin(query.anim_time*90-60)*(-15+10*query.is_on_ground)"]
				}
			}
		},
		"animation.tartuosteus.flop": {
			"loop": true,
			"animation_length": 8,
			"bones": {
				"body": {
					"rotation": ["math.sin(query.anim_time*720)*-5", "math.sin(query.anim_time*45)*10", "math.sin(query.anim_time*360-90)*5"],
					"position": ["math.sin(query.anim_time*45-120)*-2", "1+math.sin(query.anim_time*720+60)*-1", 0]
				},
				"tail": {
					"rotation": ["math.sin(query.anim_time*720+60)*5", "math.sin(query.anim_time*360+90)*-10", "math.sin(query.anim_time*360-90)*5"]
				},
				"left_fin": {
					"rotation": [0, 0, "math.sin(query.anim_time*720)*-5"]
				},
				"right_fin": {
					"rotation": [0, 0, "math.sin(query.anim_time*720)*5"]
				}
			}
		}
	}
}